    "ObjectItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScalarConfigPoint"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "fields"
      ]
    },
    "ConfigPoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScalarConfigPoint"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "list"
            },
            "default": {
              "type": "array",
              "items": {}
            },
            "required": {
              "type": "boolean",
              "default": false
            },
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ScalarSpec"
                },
                {
                  "$ref": "#/$defs/ObjectItem"
                }
              ]
            },
            "min_items": {
              "type": "integer",
              "minimum": 0
            },
            "max_items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "key",
            "label",
            "description",
            "type",
            "items"
          ]
        }
      ]
    },
    "ConfigValues": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,47}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
