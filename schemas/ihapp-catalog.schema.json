{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Estoca/inhousecloud/schemas/ihapp-catalog.schema.json",
  "title": "In House Apps catalog format",
  "description": "Proposed (LAB-159). Validate a file through its named $defs entry; semantic checks complement the schema. Signature is reserved and must be absent.",
  "$defs": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "CatalogId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]/[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$"
    },
    "Permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "boolean"
            },
            "redis": {
              "type": "boolean"
            },
            "object_storage": {
              "type": "boolean"
            },
            "tables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "database",
            "redis",
            "object_storage",
            "tables"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "const": true
            },
            "groups": {
              "type": "boolean"
            }
          },
          "required": [
            "email",
            "groups"
          ]
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service": {
                "enum": [
                  "slack",
                  "github",
                  "linear",
                  "hubspot"
                ]
              },
              "methods": {
                "type": "array",
                "items": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*(/\\.{1,2})(/|$))(?!.*//)[A-Za-z0-9/_~.-]*(?![\\s\\S])"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "why": {
                "type": "string",
                "pattern": "^[^\\r\\n]+$",
                "minLength": 1
              }
            },
            "required": [
              "service",
              "methods",
              "paths",
              "why"
            ]
          }
        },
        "mcp_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "access": {
                "enum": [
                  "read",
                  "write"
                ]
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "why": {
                "type": "string",
                "pattern": "^[^\\r\\n]+$",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "access",
              "why"
            ]
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
              },
              "why": {
                "type": "string",
                "pattern": "^[^\\r\\n]+$",
                "minLength": 1
              }
            },
            "required": [
              "host",
              "why"
            ]
          }
        }
      },
      "required": [
        "data",
        "identity",
        "connectors",
        "mcp_tools",
        "egress"
      ]
    },
    "Migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,64}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "destructive": {
          "type": "boolean"
        },
        "backfill": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "description",
        "destructive",
        "backfill"
      ]
    },
    "Release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/$defs/SemVer"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "summary": {
          "type": "string",
          "pattern": "^[^\\r\\n]+$",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "added",
                  "changed",
                  "fixed",
                  "removed",
                  "security"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "text"
            ]
          }
        },
        "breaking": {
          "type": "boolean"
        },
        "migrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Migration"
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "uniqueItems": true
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "uniqueItems": true
            },
            "renamed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                },
                "required": [
                  "from",
                  "to"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "added",
            "removed",
            "renamed"
          ]
        },
        "permissions_changed": {
          "type": "boolean"
        },
        "upgrade_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "date",
        "summary",
        "changes",
        "breaking",
        "migrations",
        "permissions_changed"
      ]
    },
    "ScalarSpec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "enum"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "label"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "options"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "email"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "group"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "money"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "BRL"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ScalarConfigPoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "string"
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string"
            },
            "default": {
              "type": "string"
            },
            "required": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "key",
            "label",
            "description",
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            },
            "label": {
