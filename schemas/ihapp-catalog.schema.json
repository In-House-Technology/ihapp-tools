            },
            "type": {
              "const": "integer"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "default": {
              "type": "integer"
            },
            "required": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "key",
